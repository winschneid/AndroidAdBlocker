    <string name="settings_about_title">About</string>
    <string name="settings_about_version">Version %1$s</string>
    <string name="settings_about_text">Runs as a local VPN built on VpnService that intercepts only the DNS queries of the device and blocks advertising and tracking domains. Only DNS is routed through the VPN; everything else flows directly as usual. No root required.</string>
    <string name="settings_about_limitations">Limitations: services that serve ads from their own domain (such as the YouTube app), a custom secure DNS provider in Chrome, Android Private DNS with a hostname, and apps with hard-coded DNS servers are not covered.</string>
